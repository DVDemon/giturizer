# —— Порты хоста (переопределяются в .env) ——
API_PORT=8000
WEB_PORT=8080

# —— PostgreSQL ——
POSTGRES_USER=archdiscovery
POSTGRES_PASSWORD=archdiscovery
POSTGRES_DB=archdiscovery
DATABASE_URL=postgresql+psycopg://archdiscovery:archdiscovery@postgres:5432/archdiscovery

# —— Redis / Celery ——
REDIS_URL=redis://redis:6379/0

# —— Общий volume для клонов и артефактов ——
DATA_DIR=/data

# —— GitLab (заполняется на этапе анализа) ——
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=

# —— Шифрование токенов (Fernet; смените на проде) ——
TOKEN_ENCRYPTION_KEY=dev-insecure-change-me

# —— Таймауты пайплайна, сек ——
CLONE_TIMEOUT=1200
ANALYZER_TIMEOUT=3600
